// Cloudflare Workers deployment (rooms mode). Build + deploy: `npm run cf:deploy`.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dwts-vote",
	// Written by @sveltejs/adapter-cloudflare; scripts/cf-postbuild.mjs appends the RoomDO export.
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"durable_objects": {
		"bindings": [{ "name": "ROOMS", "class_name": "RoomDO" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }],
	"observability": { "enabled": true }
}
