// Cloudflare Workers deployment (rooms mode). Build + deploy: `npm run cf:deploy`.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dwts-vote",
	// The adapter writes its worker here; scripts/cf-postbuild.mjs swaps in worker/entry.js, which wraps it.
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"durable_objects": {
		"bindings": [{ "name": "ROOMS", "class_name": "RoomDO" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }],
	// Custom domain (the mateh.dev zone is on this account); workers.dev stays on so old room links keep working.
	"routes": [{ "pattern": "dwts.mateh.dev", "custom_domain": true }],
	"workers_dev": true,
	"observability": { "enabled": true }
}
