{
	"name": "dwts-vote",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"fetch:episode": "node scripts/fetch-episode.mjs",
		"cf:build": "ADAPTER=cloudflare vite build && node scripts/cf-postbuild.mjs",
		"cf:dev": "npm run cf:build && wrangler dev",
		"cf:deploy": "npm run cf:build && wrangler deploy"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"sharp": "^0.35.5",
		"svelte": "^5.57.2",
		"vite": "^8.3.0",
		"wrangler": "^4.159.0"
	}
}
